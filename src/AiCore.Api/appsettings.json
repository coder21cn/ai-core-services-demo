{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AiCore": {
    "Limits": {
      "MaxPromptChars": 8000,
      "MaxOutputTokens": 1024,
      "DefaultOutputTokens": 256,
      "MaxRequestBodyBytes": 65536
    },
    "Concurrency": {
      "MaxConcurrentProviderCalls": 8,
      "MaxQueuedRequests": 16,
      "MaxQueueWaitMs": 10000
    },
    "Resilience": {
      "ProviderTimeoutMs": 30000,
      "CancellationGraceMs": 1000,
      "MaxAttempts": 2,
      "RetryBackoffMs": 250,
      "MaxAbandonedCallsPerRoute": 8
    },
    "Quotas": {
      "Default": {
        "RequestsPerMinute": 60,
        "BurstRequests": 20,
        "MaxConcurrentRequests": 4
      }
    },
    "Models": {
      "chat-default": { "Provider": "mock", "ProviderModel": "mock-echo-v1" },
      "chat-slow": { "Provider": "mock", "ProviderModel": "mock-slow-v1" },
      "sim-transient-failure": { "Provider": "mock", "ProviderModel": "mock-transient-v1" },
      "sim-permanent-failure": { "Provider": "mock", "ProviderModel": "mock-permanent-v1" },
      "sim-throttled": { "Provider": "mock", "ProviderModel": "mock-throttled-v1" },
      "sim-throttled-once": { "Provider": "mock", "ProviderModel": "mock-throttled-once-v1" }
    },
    "MockProvider": {
      "Models": {
        "mock-echo-v1": { "Behavior": "Success", "LatencyMs": 25 },
        "mock-slow-v1": { "Behavior": "Success", "LatencyMs": 2000 },
        "mock-transient-v1": { "Behavior": "TransientFailure", "LatencyMs": 10 },
        "mock-permanent-v1": { "Behavior": "PermanentFailure", "LatencyMs": 10 },
        "mock-throttled-v1": { "Behavior": "Throttled", "LatencyMs": 10 },
        "mock-throttled-once-v1": { "Behavior": "ThrottledOnFirstAttempt", "LatencyMs": 10 }
      }
    },
    "Tenants": []
  }
}
